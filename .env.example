# doubao2api-unified 环境变量（占位示例，不要填真实凭证后提交）
DOUBAO_HOST=127.0.0.1
DOUBAO_PORT=8793
# 下游鉴权：部署时必须设置，留空 = 不鉴权（wang 同款行为，仅限本地调试）
DOUBAO_API_KEY=
# 会话文件路径（0600）。不要把真实会话文件提交进仓库。
DOUBAO_SESSION_FILE=.doubao_session.json
# 或用环境变量直接给 Cookie（sessionid=...; ttwid=...; ...），二选一
# DOUBAO_COOKIE=
# 签名兜底开关（默认关；部署实测签名失败后才开）
SIGNING_FALLBACK_ENABLED=false
# 专家降级：连续无 reasoning 次数阈值 / 重试间隔秒（wang ExpertQuotaTracker 同款）
EXPERT_DEGRADED_THRESHOLD=2
EXPERT_RETRY_INTERVAL=1800
